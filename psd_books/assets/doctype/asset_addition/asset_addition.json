 "fields": [
  {
   "fieldname": "original_asset",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Original Asset",
   "options": "Asset",
   "reqd": 1,
   "description": "The asset this replacement is for. Purely informational/audit-trail \u2014 this doctype never modifies the original Asset's own qty or value; the replacement is always created as its own new Asset record (see Result section)."
  },
  {
   "fieldname": "quantity_adjustment",
   "fieldtype": "Link",
   "label": "Quantity Adjustment (if any)",
   "options": "Asset Quantity Adjustment",
   "description": "Optional link to the Asset Quantity Adjustment that necessitated this replacement, if any. Must reference the same Original Asset."
  },
  {
   "fieldname": "addition_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Addition Type",
   "options": "Paid Replacement\nFree Replacement (Warranty/Insurance)",
   "reqd": 1,
   "description": "Paid Replacement capitalizes the new unit(s) exactly like a fresh Asset purchase (tax handling included) and posts GL. Free Replacement (warranty honored in kind, insurance settlement in kind, supplier goodwill) creates the replacement Asset at zero cost with no GL impact \u2014 it only restores quantity."
  },
  {
   "fieldname": "addition_date",
   "fieldtype": "Date",
   "label": "Addition Date",
   "reqd": 1,
   "default": "Today",
   "description": "Used as both Purchase Date and Available for Use Date on the replacement Asset."
  },
  {
   "fieldname": "company",
   "fieldtype": "Data",
   "label": "Company",
   "read_only": 1,
   "description": "Stamped from the Original Asset on save."
  },
  {
   "fieldname": "qty",
   "fieldtype": "Float",
   "in_list_view": 1,
   "label": "Replacement Qty",
   "reqd": 1
  },
  {
   "fieldname": "reason",
   "fieldtype": "Small Text",
   "label": "Reason",
   "reqd": 1
  },
  {
   "fieldname": "paid_section",
   "fieldtype": "Section Break",
   "label": "Paid Replacement Details",
   "depends_on": "eval:doc.addition_type=='Paid Replacement'"
  },
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "Supplier",
   "options": "Supplier"
  },
  {
   "fieldname": "credit_account",
   "fieldtype": "Link",
   "label": "Credit Account (Payable / Bank / Cash)",
   "options": "Account",
   "description": "Required for a Paid Replacement \u2014 credited on capitalization, same role as Asset.credit_account for a fresh purchase."
  },
  {
   "fieldname": "column_break_paid",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "taxable_value",
   "fieldtype": "Currency",
   "label": "Taxable Value",
   "description": "Required, greater than zero, for a Paid Replacement."
  },
  {
   "fieldname": "total_tax",
   "fieldtype": "Currency",
   "label": "Total Tax",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "purchase_cost",
   "fieldtype": "Currency",
   "label": "Purchase Cost",
   "read_only": 1,
   "no_copy": 1,
   "description": "Taxable Value + non-ITC-eligible tax \u2014 same formula as Asset.calculate_totals(). Zero for a Free Replacement."
  },
  {
   "fieldname": "taxes_section",
   "fieldtype": "Section Break",
