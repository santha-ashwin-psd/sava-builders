   "idx": 57
  },
  {
   "fieldname": "send_payment_reminders",
   "fieldtype": "Check",
   "label": "Send Overdue Payment Reminders",
   "description": "Automatically email overdue invoice reminders to customers",
   "idx": 58
  },
  {
   "fieldname": "col_reminders",
