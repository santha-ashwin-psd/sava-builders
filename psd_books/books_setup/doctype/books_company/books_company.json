   "idx": 60
  },
  {
   "fieldname": "reminder_days_after",
   "fieldtype": "Int",
   "label": "Remind N days After Due",
   "default": "7",
   "depends_on": "eval:doc.send_payment_reminders",
   "idx": 61
  },
  {
   "fieldname": "sec_inventory_accounts",
   "fieldtype": "Section Break",
   "label": "Inventory Accounts",
   "description": "Defaults for perpetual inventory GL posting. Item-level overrides win when set.",
   "collapsible": 1
  },
  {
   "fieldname": "default_inventory_account",
   "fieldtype": "Link",
   "options": "Account",
   "label": "Default Inventory Account",
   "description": "Stock asset account (e.g. Stock In Hand). Used when Item has no inventory_account."
  },
  {
   "fieldname": "stock_received_not_billed",
   "fieldtype": "Link",
   "options": "Account",
   "label": "Stock Received",
   "description": "GR/IR clearing liability. Credited on goods receipt, debited when the purchase invoice is booked."
  },
  {
   "fieldname": "col_inventory_accounts",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_cogs_account",
   "fieldtype": "Link",
   "options": "Account",
   "label": "Default COGS Account",
   "description": "Debited when stock is issued/sold (Material Issue)."
  },
  {
   "fieldname": "default_scrap_account",
   "fieldtype": "Link",
   "options": "Account",
   "label": "Default Scrap/By-Product Account",
   "description": "Debited for recoverable scrap/by-products received from a Work Order, instead of the Default Inventory Account, when Manufacturing Settings > Segregate Scrap/By-Product GL is enabled. Falls back to the Default Inventory Account if left blank."
  },
  {
   "fieldname": "sec_qc",
   "fieldtype": "Section Break",
   "label": "Quality Control"
  },
  {
   "fieldname": "default_quarantine_warehouse",
   "fieldtype": "Link",
   "options": "Warehouse",
   "label": "Default Quarantine Warehouse (Raw Material)",
   "description": "Stock from failed/pending QC Inspections on incoming (RM) receipts is auto-routed here for this company."
  },
  {
   "fieldname": "default_fg_quarantine_warehouse",
   "fieldtype": "Link",
   "options": "Warehouse",
   "label": "Default Quarantine Warehouse (Finished Goods)",
   "description": "Finished-goods rows from Manufacturing that require QC Inspection are auto-routed here instead of default_quarantine_warehouse. Falls back to Default Quarantine Warehouse (Raw Material) if left blank."
  },
  {
   "fieldname": "default_scrap_warehouse",
   "fieldtype": "Link",
   "options": "Warehouse",
   "label": "Default Scrap Warehouse"
  },
  {
   "fieldname": "col_qc",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "qc_hard_block",
   "fieldtype": "Check",
   "label": "Hard Block on QC Failure",
   "description": "Phase 4: if checked (default), submission of a QC-flagged row is blocked outright until QC clears -- no override. Uncheck to fall back to the old soft-warn behaviour (a dismissible confirm dialog).",
   "default": "1"
  },
  {
   "fieldname": "qc_auto_release_on_pass",
   "fieldtype": "Check",
   "label": "Auto-Release Stock from Quarantine on QC Pass",
   "default": "1",
   "description": "Phase 3: when a QC-quarantined row's inspection is submitted as Pass, automatically create the release Stock Entry moving stock from quarantine to its original target warehouse for this company. Turn off if you'd rather review and release each Pass manually (e.g. once a segregation-of-duties requirement is introduced later). Company-scoped, like Hard Block on QC Failure above -- Books Settings is a single global doctype and would otherwise share one toggle across every company in a multi-tenant setup."
  },
  {
   "fieldname": "qc_require_second_signoff",
   "fieldtype": "Check",
   "label": "Require Second Sign-off on QC Inspections",
   "description": "If checked, a QC Inspection cannot be submitted unless 'Verified By' is set to a different user than 'Inspected By' -- enforces a dual-signature review before a batch's QC result is finalised.",
   "default": "0"
  },
  {
   "fieldname": "sec_lock",
   "fieldtype": "Section Break",
   "idx": 62,
   "label": "Period Lock"
  },
  {
   "fieldname": "lock_date",
   "fieldtype": "Date",
   "idx": 63,
   "label": "Books Lock Date",
   "description": "Freeze all financial transactions on or before this date. Only a System Manager can post past it."
  }
 ],
