  {
   "fieldname": "operating_cost_absorbed",
   "fieldtype": "Currency",
   "label": "Operating Cost Absorbed",
   "read_only": 1,
   "no_copy": 1,
   "default": "0",
   "description": "Labor/overhead folded into the finished good's valuation on this Manufacture entry -- from a Work Order's Total Operating Cost (complete_work_order()) or a Packing Slip's Packing Operating Cost (post_packing_consumption()). Used to balance the WIP GL leg against an Operating Cost Absorbed account."
  },
  {
   "fieldname": "manufacturing_variance_loss",
   "fieldtype": "Currency",
   "label": "Manufacturing Variance Loss",
   "read_only": 1,
   "no_copy": 1,
   "default": "0",
   "description": "Set automatically by complete_work_order() when recoverable scrap value exceeds the raw material + operating cost pool for this run, so the finished good's rate would otherwise be clamped below zero. This is the shortfall that could not be absorbed into FG valuation -- it is written off to a loss/variance account instead of being left as a stranded balance in Work In Progress."
  },
  {
   "fieldname": "process_loss_qty",
   "fieldtype": "Float",
   "label": "Process Loss Qty",
   "read_only": 1,
   "no_copy": 1,
   "default": "0",
   "description": "The process_loss_qty this specific Manufacture entry contributed to its Work Order (manual/legacy arg plus any is_process_loss scrap rows, set by complete_work_order()). Never moves stock on its own -- stored here purely so reverse_manufacture_entry() can roll back exactly this run's contribution from the Work Order's cumulative process_loss_qty instead of leaving it stale after a reversal."
  },
  {
   "fieldname": "over_production_qty",
   "fieldtype": "Float",
   "label": "Over Production Qty",
   "read_only": 1,
   "no_copy": 1,
   "default": "0",
   "description": "This specific Manufacture entry's actual contribution to the Work Order's cumulative over_production_qty (this_run_over_qty, set by complete_work_order() -- not the raw over_production_qty argument the caller passed in, which may overstate the real overshoot). Stored here for the same reason as process_loss_qty above: so reverse_wo_completion() can roll back exactly this run's contribution from the Work Order's cumulative over_production_qty instead of leaving it stale (permanently overstated) after a reversal."
  },
