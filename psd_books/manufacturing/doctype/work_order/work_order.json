  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nSubmitted\nIn Process\nCompleted\nStopped\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "no_copy": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sec_wo_yield",
   "fieldtype": "Section Break",
   "label": "Production Progress"
  },
  {
   "fieldname": "produced_qty",
   "fieldtype": "Float",
   "label": "Produced Qty",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "over_production_qty",
   "fieldtype": "Float",
   "label": "Over Production Qty",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "description": "Cumulative qty produced beyond the planned Qty to Manufacture, explicitly entered at completion time (e.g. batch yielded 1250 against a planned 1000 -- 250 recorded here). Included in produced_qty/FG stock as normal; this field exists purely so the extra is visible and reportable separately, without relying on a global over-production % setting."
  },
  {
   "fieldname": "col_break_wo_yield",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "process_loss_qty",
   "fieldtype": "Float",
   "label": "Process Loss / Wastage Qty",
   "read_only": 1,
   "default": "0",
   "no_copy": 1
  },
  {
   "fieldname": "qty_reconciled_via_loss",
   "fieldtype": "Check",
   "label": "Completed via Loss Reconciliation",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "hidden": 1,
   "description": "Set when this Work Order was marked Completed because produced_qty + process_loss_qty (not produced_qty alone) reached the planned qty -- see complete_work_order's close_on_loss_reconciliation flag. Read by _stamp_wo_completed so it can recognise this Work Order as genuinely finished even though produced_qty alone never reaches qty."
  },
  {
   "fieldname": "process_loss_percent",
   "fieldtype": "Percent",
   "label": "Expected Process Loss %",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "description": "Snapshot of the BOM's Process Loss % at Work Order creation. Used at completion to split actual process loss into normal (capitalized into FG cost) vs abnormal (expensed to variance)."
  },
  {
   "fieldname": "sec_wo_warehouses",
   "fieldtype": "Section Break",
   "label": "Warehouses"
  },
  {
   "fieldname": "source_warehouse",
   "fieldtype": "Link",
   "label": "Default Source Warehouse (Raw Materials)",
   "options": "Warehouse",
   "reqd": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "wip_warehouse",
   "fieldtype": "Link",
   "label": "Work-in-Progress Warehouse",
   "options": "Warehouse",
   "description": "Optional. If set, raw materials are transferred here before Complete Work Order consumes them. If blank, Complete Work Order consumes directly from Source Warehouse.",
   "allow_on_submit": 1
  },

  {
   "fieldname": "col_break_wo_warehouses",
   "fieldtype": "Column Break",
   "label": ""
  },
