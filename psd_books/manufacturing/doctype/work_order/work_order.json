   "fieldtype": "Date",
   "label": "Planned End Date"
  },
  {
   "fieldname": "sec_wo_materials",
   "fieldtype": "Section Break",
   "label": "Raw Materials"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Raw Materials",
   "options": "Work Order Item"
  },
  {
   "fieldname": "items_loaded_for_qty",
   "fieldtype": "Float",
   "label": "Materials Loaded For Qty",
   "default": "0",
   "hidden": 1,
   "read_only": 1,
   "description": "Internal. Snapshot of Qty to Manufacture at the moment the Raw Material/Operations tables were last loaded or refreshed from the BOM. Used to detect a Work Order where Qty was edited afterward without re-syncing materials, which would otherwise under/over-consume raw materials and mis-value the finished good."
  },
  {
   "fieldname": "sec_wo_ops",
   "fieldtype": "Section Break",
   "label": "Operations"
  },
  {
   "fieldname": "operations",
   "fieldtype": "Table",
   "label": "Operations",
   "options": "Work Order Operation"
  },
  {
   "fieldname": "sec_wo_op_cost",
   "fieldtype": "Section Break",
   "label": "Operation Cost"
  },
  {
   "fieldname": "planned_operating_cost",
   "fieldtype": "Currency",
   "label": "Planned Operating Cost",
   "read_only": 1,
   "default": "0",
   "description": "Sum of Hour Rate \u00d7 Planned Time across all Operations."
  },
  {
   "fieldname": "actual_operating_cost",
   "fieldtype": "Currency",
   "label": "Actual Operating Cost",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "description": "Sum of Hour Rate \u00d7 Actual Time (rolled up from Job Cards) across all Operations."
  },
  {
   "fieldname": "col_break_wo_op_cost",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "additional_operating_cost",
   "fieldtype": "Currency",
   "label": "Additional Operating Cost",
   "default": "0",
   "allow_on_submit": 1,
   "description": "Manually entered extra operating costs not captured on any Operation row (e.g. subcontracting, rework)."
  },
  {
   "fieldname": "total_operating_cost",
   "fieldtype": "Currency",
   "label": "Total Operating Cost",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "bold": 1,
   "description": "Actual Operating Cost + Additional Operating Cost (falls back to Planned Operating Cost before any time is logged)."
  },
  {
   "fieldname": "operating_cost_absorbed_total",
   "fieldtype": "Currency",
   "label": "Operating Cost Absorbed (Cumulative)",
   "read_only": 1,
   "default": "0",
   "no_copy": 1,
   "description": "Running total of operating cost actually absorbed into FG valuation across all completions so far. Trued up against Total Operating Cost on the final completion."
  },
  {
